HOST=127.0.0.1
PORT=3210
PUBLIC_BASE_URL=https://merhaba-api.kiyan.finance
SMART_INSPECTION_PROVIDER=codex
CODEX_COMMAND=codex
# Optional. Omit to use the CLI's default model.
CODEX_MODEL=
AGENT_TIMEOUT_SECONDS=120
MIN_TURN_INTERVAL_SECONDS=10
SESSION_TURN_LIMIT=60
DAILY_TURN_LIMIT=300
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
# Optional AWS_PROFILE, never put AWS credentials in the app.
# Development CORS permits only the app and local previews by default.
CORS_ORIGINS=https://merhaba-api.kiyan.finance,https://localhost,http://localhost,http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:5173,http://localhost:5173
